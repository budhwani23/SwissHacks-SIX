# Copy this to .env and fill in your values

# Phoeniqs / OpenAI-compatible LLM
PHOENIQS_BASE_URL=https://your-phoeniqs-endpoint/v1
PHOENIQS_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini

# Optional: live news via Event Registry
EVENT_REGISTRY_API_KEY=

# Optional: NewsAPI
NEWS_API_KEY=

# Voice assistant — Google Gemini (speech-to-text + text-to-speech)
GEMINI_API_KEY=
# Optional overrides:
GEMINI_STT_MODEL=gemini-2.0-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
